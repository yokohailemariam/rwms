model Notification {
    id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    tenantId    String           @db.Uuid
    recipientId String           @db.Uuid
    type        NotificationType
    title       String
    body        String
    status      NotifStatus      @default(PENDING)
    channel     String?
    externalId  String?
    sentAt      DateTime?
    readAt      DateTime?
    metadata    Json?
    createdAt   DateTime         @default(now())

    @@index([tenantId])
    @@index([recipientId])
    @@index([status])
    @@map("notifications")
}
